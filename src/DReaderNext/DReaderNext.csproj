<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48：Win10 21H2+/Win11 预装运行时，免安装、无运行时打包（对应发布体积目标） -->
    <TargetFramework>net48</TargetFramework>
    <!-- 关键：用最新语言版本编译 net48，文件作用域 namespace / target-typed new / record 等语法原样保留 -->
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DReaderNext</RootNamespace>
    <AssemblyName>DReaderNext</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.0</Version>
    <!-- 高 DPI：net48 没有 ApplicationHighDpiMode 源生成器，改由 manifest 声明 PerMonitorV2（对应验收项 9） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：嵌进 exe，资源管理器/任务栏/托盘共用（托盘与各窗体的 Icon 由 AppIcon 从 exe 反取） -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- net48 参考程序集：本机没装 Developer Pack，直接指向框架目录编译（等价于
         Microsoft.NETFramework.ReferenceAssemblies 包做的事）。同时关掉 SDK 自动引入的
         同名包——它需要联网还原，而本机 dotnet 访问不到 nuget.org。 -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == '' and Exists('C:\Windows\Microsoft.NET\Framework64\v4.0.30319\mscorlib.dll')">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup>
    <!-- 导出诊断日志要打 zip：net48 下 ZipArchive 在 System.IO.Compression（GAC 自带，不随发布复制） -->
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
