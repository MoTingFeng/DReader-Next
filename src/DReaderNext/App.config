<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- .NET Framework 的 WinForms 在 net48 上光看 manifest 不够：不在这里显式开启，
       DeviceDpi 会一直是 96，PerMonitorV2 的高 DPI 换算就退化成「窗口只有一半大」。
       这是 net10（ApplicationHighDpiMode 源生成器）迁到 net48 后必须补的一环。 -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
